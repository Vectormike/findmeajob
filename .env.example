APP_ENV=dev
DATABASE_URL=postgresql://findmeajob:findmeajob@localhost:5433/findmeajob

# Your xAI key for Grok. Keep it only in .env, which git ignores.
XAI_API_KEY=
XAI_MODEL=grok-4.7

GMAIL_CREDENTIALS_FILE=secrets/gmail_client.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
COURIER_POLL_SECONDS=300

# A long random string. Read AI posts to /webhooks/readai/<this secret>.
READAI_WEBHOOK_SECRET=

CHROME_PROFILE_DIR=.chrome-profile
CHROME_HEADLESS=true
DATA_DIR=data
SCOUT_MAX_CASES=20
